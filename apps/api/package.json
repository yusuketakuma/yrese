{
  "name": "@yrese/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "db:check": "tsx src/db/check.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "dev": "NODE_ENV=development YRESE_ALLOW_DEV_TENANT_STUB=true YRESE_API_REPOSITORY_MODE=in_memory tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@yrese/audit": "workspace:*",
    "@yrese/contracts": "workspace:*",
    "@yrese/date-time": "workspace:*",
    "@yrese/shared-kernel": "workspace:*",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
